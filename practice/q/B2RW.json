ord mathnormal\">e</span></span><span class=\"mpunct\">;</span></span></span></span></span> and <span class=\"katex-lite\" role=\"img\" aria-label=\"(1,1,1)\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mopen\">(</span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">1</span><span class=\"mclose\">)</span></span></span></span></span></span> and <span class=\"katex-lite\" role=\"img\" aria-label=\"(0,3,2)\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mopen\">(</span><span class=\"mord\">0</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">3</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord\">2</span><span class=\"mclose\">)</span></span></span></span></span></span> after <span class=\"katex-lite\" role=\"img\" aria-label=\"cf,\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">c</span><span class=\"mord mathnormal\" style=\"margin-right:0.1076em;\">f</span></span><span class=\"mpunct\">,</span></span></span></span></span> for <span class=\"katex-lite\" role=\"img\" aria-label=\"h\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">h</span></span></span></span></span></span> and <span class=\"katex-lite\" role=\"img\" aria-label=\"i\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6595em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">i</span></span></span></span></span></span> respectively.</p></div><ol class=\"pq-parts\" role=\"list\"><li class=\"pq-part\"><span class=\"pq-l\">(i)</span><div class=\"pq-pq\"><div class=\"ue-math\"><p>Find all the pure-strategy Nash equilibria. (Hint: write the game in normal form.)</p></div><div class=\"pq-ans\" data-answer><p class=\"pq-ans-k\">Answer</p><div class=\"ue-math\"><p>Our answer: the normal form with strategy sets <span class=\"katex-lite\" role=\"img\" aria-label=\"a,b,c,\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mopen\">{</span><span class=\"mord mathnormal\">a</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">b</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">c</span><span class=\"mclose\">}</span></span><span class=\"mpunct\">,</span></span></span></span></span> <span class=\"katex-lite\" role=\"img\" aria-label=\"d,e×g,f\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mopen\">{</span><span class=\"mord mathnormal\">d</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">e</span><span class=\"mclose\">}</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mopen\">{</span><span class=\"mord mathnormal\" style=\"margin-right:0.0359em;\">g</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.1076em;\">f</span><span class=\"mclose\">}</span></span></span></span></span></span> and <span class=\"katex-lite\" role=\"img\" aria-label=\"h,i,\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\"><span class=\"mopen\">{</span><span class=\"mord mathnormal\">h</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">i</span><span class=\"mclose\">}</span></span><span class=\"mpunct\">,</span></span></span></span></span> each profile paid according to the terminal history it reaches.</p></div></div></div></li><li class=\"pq-part\"><span class=\"pq-l\">(ii)</span><div class=\"pq-pq\"><div class=\"ue-math\"><p>Which of these Nash equilibria can be supported as weak perfect Bayesian equilibria? Either explain why a given Nash equilibrium cannot be supported as a weak PBE, or provide a belief system which, together with the strategy profile, is a weak PBE.</p></div><div class=\"pq-ans\" data-answer><p class=\"pq-ans-k\">Answer</p><div class=\"ue-math\"><p>Our rendering of the belief system the question asks for. At the three singleton information sets every belief system puts weight <span class=\"katex-lite\" role=\"img\" aria-label=\"1.\"><span class=\"katex\"><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.6444em;\"></span><span class=\"mord\"><span class=\"mord\">1</span></span><span class=\"mord\">.</span></span></span></span></span></p></div></div></div></li><li class=\"pq-part\"><span class=\"pq-l\">(iii)</span><div class=\"pq-pq\"><div class=\"ue-math\"><p>Find one Nash equilibrium that can be supported as a sequential equilibrium, and provide a belief system which, together with the strategy profile, is a sequential equilibrium.</p></div><div class=\"pq-ans\" data-answer><p class=\"pq-ans-k\">Answer</p><div class=\"ue-math\"><p>Our reading of “sequential equilibrium”: the standard definition by consistent beliefs and sequential rationality.</p></div></div></div></li></ol>"}